map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Do not log query strings: password recovery links contain a token.
log_format app_access '$remote_addr $request_method $uri $status $body_bytes_sent';

server {
    listen 80;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log app_access;
    client_max_body_size 10m;

    # Resolve container names again after an API/frontend recreation.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream backend:8000;
    set $ui_upstream frontend:3000;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location ^~ /api/v1/socket.io/ {
        proxy_pass http://$api_upstream;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/(api/|health$|docs(?:/|$)|redoc(?:/|$)|openapi\.json$) {
        proxy_pass http://$api_upstream;
    }

    location / {
        proxy_pass http://$ui_upstream;
    }
}
