# Generated secrets belong only in .env.server on the server.
COMPOSE_PROJECT_NAME=smart-task-manager-server
PUBLIC_URL=http://localhost:8080
PUBLIC_SCHEME=http
HTTP_PORT=8080
HTTP_BIND=0.0.0.0
MYSQL_DATABASE=smart_task_manager
MYSQL_USER=smart_task
MYSQL_ROOT_PASSWORD=generated-by-setup
MYSQL_PASSWORD=generated-by-setup
JWT_SECRET=generated-by-setup
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SEED_DEMO=false
DEMO_PASSWORD=generated-by-setup
